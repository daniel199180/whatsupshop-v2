# ─────────────────────────────────────────────────────────────────────────────
# WhatsUpShop — Production environment variables
#
# Copy this file to .env and fill in every value before deploying.
# For multi-client deployments, each client needs its own copy with unique
# values for the sections marked "PER-CLIENT".
#
# Use COMPOSE_PROJECT_NAME to isolate Docker volumes per client so they never
# share mysql_data, uploads_data, or db_backups by accident:
#
#   COMPOSE_PROJECT_NAME=whatsupshop_cliente_acme
#
# ─────────────────────────────────────────────────────────────────────────────

# ── Multi-client isolation (PER-CLIENT) ──────────────────────────────────────
# Prefix for all Docker resources (volumes, networks, container names).
# Change this for every client to prevent data cross-contamination.
COMPOSE_PROJECT_NAME=whatsupshop_cliente_nombre

# ── Frontend (PER-CLIENT) ─────────────────────────────────────────────────────
# Full public URL of the backend API. Must be reachable by the browser.
PUBLIC_API_URL=https://api.tudominio.com

# ── Database — MySQL (PER-CLIENT) ────────────────────────────────────────────
# Host: use "db" when running inside the same docker-compose project.
DB_HOST=db
DB_PORT=3306

# These three values must match the MYSQL_* variables below.
DB_USER=whatsupshop_user
DB_PASSWORD=change_me_secure_password
DB_NAME=whatsupshop

# Root password used only during MySQL container initialisation.
DB_ROOT_PASSWORD=change_me_root_password

# ── Backend — Security (PER-CLIENT) ──────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET=change_me_64_char_hex_secret_generate_with_openssl_rand_hex_32

# Admin panel credentials
ADMIN_USERNAME=admin
# Generate with: cd backend && bun run hash-password 'your_password'
ADMIN_PASSWORD_HASH=change_me_bcrypt_hash

# ── Backend — Server (PER-CLIENT) ────────────────────────────────────────────
PORT=3000
# Full public URL of the backend (used to build absolute image URLs).
PUBLIC_URL=https://api.tudominio.com
# Allowed CORS origin(s). Comma-separated for multiple origins.
CORS_ORIGIN=https://tudominio.com

# ── Migration behaviour (optional, defaults shown) ───────────────────────────
# Set to "false" to skip the pre-migration backup (not recommended).
AUTO_BACKUP_BEFORE_MIGRATE=true
# Number of days to keep pre-migration backups. Set to 0 to disable pruning.
BACKUP_RETENTION_DAYS=7
