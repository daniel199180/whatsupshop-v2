# WhatsUpShop v2 — Minimal production configuration
#
# Copy this file to .env (or paste variables directly in EasyPanel) and set
# the required values. The system auto-generates all secrets on first deploy.
#
# ── Required ──────────────────────────────────────────────────────────────────
COMPOSE_PROJECT_NAME=whatsupshop_cliente_demo
APP_DOMAIN=tudominio.com
API_DOMAIN=api.tudominio.com
ADMIN_PASSWORD=TuPasswordAdminSegura

# ── Optional (defaults shown) ─────────────────────────────────────────────────
# ADMIN_USERNAME=admin
# DB_NAME=whatsupshop
# DB_USER=whatsupshop_user
# BACKUP_RETENTION_DAYS=7
# AUTO_BACKUP_BEFORE_MIGRATE=true

# ── Auto-generated (do NOT set manually) ──────────────────────────────────────
# The setup service writes these to the app_secrets volume on first deploy.
# They are NEVER regenerated on redeployment.
#
# JWT_SECRET           — 32-byte hex random
# DB_PASSWORD          — 24-byte hex random
# DB_ROOT_PASSWORD     — 24-byte hex random
# ADMIN_PASSWORD_HASH  — bcrypt(ADMIN_PASSWORD, cost=12)
# PUBLIC_URL           — https://API_DOMAIN
# PUBLIC_API_URL       — https://API_DOMAIN
# CORS_ORIGIN          — https://APP_DOMAIN
