FROM mysql:8.0
WORKDIR /app

COPY scripts/db-user-init.sh ./scripts/db-user-init.sh
RUN chmod +x ./scripts/db-user-init.sh

# One-shot container: ensures DB_USER exists with correct password and
# privileges before migrate runs. Uses the official MySQL 8.0 client
# (native caching_sha2_password support). Safe to run on every deploy.
CMD ["bash", "./scripts/db-user-init.sh"]
