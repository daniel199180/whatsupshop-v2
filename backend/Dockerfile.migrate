FROM oven/bun:1-debian

WORKDIR /app

# default-mysql-client on Debian bookworm installs MariaDB 10.11+, which
# supports MySQL 8.0's caching_sha2_password auth plugin — unlike Alpine's
# older MariaDB client. gzip compresses pre-migration backups.
RUN apt-get update \
  && apt-get install -y --no-install-recommends bash gzip default-mysql-client ca-certificates \
  && rm -rf /var/lib/apt/lists/*

COPY package.json bun.lock ./
# Install all deps (including drizzle-kit in devDependencies).
RUN bun install

COPY drizzle.config.ts ./
COPY src ./src
COPY drizzle ./drizzle
COPY scripts ./scripts

RUN chmod +x ./scripts/migrate.sh

# One-shot container: runs migrate.sh and exits.
# docker-compose depends_on condition: service_completed_successfully
# ensures the backend only starts when this exits 0.
CMD ["bash", "./scripts/migrate.sh"]
