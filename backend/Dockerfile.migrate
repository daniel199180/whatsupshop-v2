FROM mysql:8.0

WORKDIR /app

# mysql:8.0 runs on Oracle Linux 8 slim — microdnf is the package manager.
# curl + unzip are required by the Bun installer; gzip compresses backups.
RUN microdnf install -y curl unzip gzip ca-certificates bash \
  && microdnf clean all

# Install Bun runtime.
ENV BUN_INSTALL=/usr/local/bun
RUN curl -fsSL https://bun.sh/install | bash
ENV PATH="/usr/local/bun/bin:${PATH}"

COPY package.json bun.lock ./
# Install all deps (including drizzle-kit in devDependencies).
RUN bun install

COPY drizzle.config.ts ./
COPY src ./src
COPY drizzle ./drizzle
COPY scripts ./scripts

RUN chmod +x ./scripts/migrate.sh

# Clear MySQL's default ENTRYPOINT so we run migrate.sh, not mysqld.
ENTRYPOINT []
CMD ["bash", "./scripts/migrate.sh"]
