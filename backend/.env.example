# ─── Database ──────────────────────────────────────────────────────────
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=mydatabase

# ─── Authentication ────────────────────────────────────────────────────
# Generate a strong secret: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_to_a_64_char_random_string

# Admin credentials
ADMIN_USERNAME=admin
# Generate hash: bunx bcrypt-cli hash "your_password" 12
ADMIN_PASSWORD_HASH=$2b$12$REPLACE_WITH_YOUR_BCRYPT_HASH

# ─── Server ────────────────────────────────────────────────────────────
PORT=3000

# ─── CORS ──────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (your frontend URL)
CORS_ORIGIN=http://localhost:4321
