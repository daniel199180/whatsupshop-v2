# ─── Database ──────────────────────────────────────────────────────────
DB_HOST=db
DB_PORT=3306
DB_USER=user
DB_PASSWORD=your_db_password
DB_NAME=mydatabase

# ─── Authentication ────────────────────────────────────────────────────
# Generate: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_to_a_64_char_random_string

# Admin credentials
ADMIN_USERNAME=admin
# Generate: bun run hash-password 'tu_contraseña'
ADMIN_PASSWORD_HASH=$2b$12$REPLACE_WITH_YOUR_BCRYPT_HASH

# ─── Server ────────────────────────────────────────────────────────────
PORT=3000

# Public URL del backend (sin barra final) — usada en las URLs de imágenes
PUBLIC_URL=https://api.tudominio.com

# ─── CORS ──────────────────────────────────────────────────────────────
# URL del frontend en producción
CORS_ORIGIN=https://tudominio.com
