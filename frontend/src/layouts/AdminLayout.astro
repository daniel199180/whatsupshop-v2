---
import '../styles/global.css';
import '../styles/admin.css';
import { API_BASE_URL } from '../lib/api';

export interface Props {
  title?: string;
  currentPage?: string;
}
const { title = 'Admin — WhatsUpShop', currentPage = 'dashboard' } = Astro.props;
const apiUrl = API_BASE_URL;

const navItems = [
  { id: 'dashboard', label: 'Dashboard', href: '/admin/dashboard', icon: 'chart' },
  { id: 'products', label: 'Productos', href: '/admin/products', icon: 'box' },
  { id: 'categories', label: 'Categorías', href: '/admin/categories', icon: 'tag' },
  { id: 'orders', label: 'Pedidos', href: '/admin/orders', icon: 'clipboard' },
  { id: 'config', label: 'Configuración', href: '/admin/config', icon: 'cog' },
];
---
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex, nofollow" />
  <title>{title}</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
</head>
<body>
  <div class="admin-shell" x-data="adminAuth()" x-init="checkAuth()">
    <!-- Auth gate: show login or admin panel -->
    <template x-if="!authenticated">
      <div class="flex items-center justify-center min-h-screen bg-gray-50 px-4">
        <div class="w-full max-w-sm">
          <div class="text-center mb-8">
            <div class="w-14 h-14 bg-[#25D366] rounded-2xl flex items-center justify-center mx-auto mb-4 shadow-lg shadow-[#25D366]/30">
              <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 10-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H6.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z" />
              </svg>
            </div>
            <h1 class="text-2xl font-bold text-gray-900">WhatsUpShop Admin</h1>
            <p class="text-gray-500 text-sm mt-1">Ingresa tus credenciales para continuar</p>
          </div>

          <form @submit.prevent="login()" class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 space-y-4">
            <div>
              <label class="admin-label">Usuario</label>
              <input type="text" x-model="loginForm.username" class="admin-input" placeholder="admin" required autocomplete="username" />
            </div>
            <div>
              <label class="admin-label">Contraseña</label>
              <input type="password" x-model="loginForm.password" class="admin-input" placeholder="••••••••" required autocomplete="current-password" />
            </div>
            <div x-show="loginError" class="text-red-500 text-sm font-medium bg-red-50 rounded-lg px-3 py-2" x-text="loginError"></div>
            <button type="submit" class="btn-primary w-full justify-center" :disabled="loginLoading">
              <span x-show="!loginLoading">Iniciar sesión</span>
              <span x-show="loginLoading">Ingresando...</span>
            </button>
          </form>

          <a href="/" class="block text-center text-sm text-gray-400 mt-6 hover:text-[#25D366] transition-colors">
            ← Volver a la tienda
          </a>
        </div>
      </div>
    </template>

    <!-- Authenticated admin panel -->
    <template x-if="authenticated">
      <div class="admin-layout">
        <!-- Sidebar overlay (mobile) -->
        <div class="admin-sidebar-overlay" :class="{ open: sidebarOpen }" @click="sidebarOpen = false"></div>

        <!-- Sidebar -->
        <aside class="admin-sidebar" :class="{ open: sidebarOpen }">
          <!-- Logo area -->
          <div class="px-6 py-5 border-b border-white/10">
            <div class="flex items-center gap-3">
              <div class="w-9 h-9 bg-[#25D366] rounded-xl flex items-center justify-center">
                <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 10.5V6a3.75 3.75 0 10-7.5 0v4.5m11.356-1.993l1.263 12c.07.665-.45 1.243-1.119 1.243H4.25a1.125 1.125 0 01-1.12-1.243l1.264-12A1.125 1.125 0 015.513 7.5h12.974c.576 0 1.059.435 1.119 1.007zM8.625 10.5a.375.375 0 11-.75 0 .375.375 0 01.75 0zm7.5 0a.375.375 0 11-.75 0 .375.375 0 01.75 0z" />
                </svg>
              </div>
              <div>
                <p class="font-bold text-sm text-white">WhatsUpShop</p>
                <p class="text-gray-500 text-[11px]">Panel Admin</p>
              </div>
            </div>
          </div>

          <!-- Navigation -->
          <nav class="flex-1 py-4">
            <p class="px-6 text-[10px] font-semibold text-gray-500 uppercase tracking-widest mb-2">Menú</p>
            {navItems.map(item => (
              <a href={item.href} class={`nav-item ${currentPage === item.id ? 'active' : ''}`}>
                {item.icon === 'chart' && (
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 013 19.875v-6.75zM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V8.625zM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V4.125z" /></svg>
                )}
                {item.icon === 'box' && (
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M20.25 7.5l-.625 10.632a2.25 2.25 0 01-2.247 2.118H6.622a2.25 2.25 0 01-2.247-2.118L3.75 7.5M10 11.25h4M3.375 7.5h17.25c.621 0 1.125-.504 1.125-1.125v-1.5c0-.621-.504-1.125-1.125-1.125H3.375c-.621 0-1.125.504-1.125 1.125v1.5c0 .621.504 1.125 1.125 1.125z" /></svg>
                )}
                {item.icon === 'tag' && (
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9.568 3H5.25A2.25 2.25 0 003 5.25v4.318c0 .597.237 1.17.659 1.591l9.581 9.581c.699.699 1.78.872 2.607.33a18.095 18.095 0 005.223-5.223c.542-.827.369-1.908-.33-2.607L11.16 3.66A2.25 2.25 0 009.568 3z" /><path stroke-linecap="round" stroke-linejoin="round" d="M6 6h.008v.008H6V6z" /></svg>
                )}
                {item.icon === 'clipboard' && (
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h3.75M9 15h3.75M9 18h3.75m3 .75H18a2.25 2.25 0 002.25-2.25V6.108c0-1.135-.845-2.098-1.976-2.192a48.424 48.424 0 00-1.123-.08m-5.801 0c-.065.21-.1.433-.1.664 0 .414.336.75.75.75h4.5a.75.75 0 00.75-.75 2.25 2.25 0 00-.1-.664m-5.8 0A2.251 2.251 0 0113.5 2.25H15c1.012 0 1.867.668 2.15 1.586m-5.8 0c-.376.023-.75.05-1.124.08C9.095 4.01 8.25 4.973 8.25 6.108V8.25m0 0H4.875c-.621 0-1.125.504-1.125 1.125v11.25c0 .621.504 1.125 1.125 1.125h9.75c.621 0 1.125-.504 1.125-1.125V9.375c0-.621-.504-1.125-1.125-1.125H8.25zM6.75 12h.008v.008H6.75V12zm0 3h.008v.008H6.75V15zm0 3h.008v.008H6.75V18z" /></svg>
                )}
                {item.icon === 'cog' && (
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9.594 3.94c.09-.542.56-.94 1.11-.94h2.593c.55 0 1.02.398 1.11.94l.213 1.281c.063.374.313.686.645.87.074.04.147.083.22.127.324.196.72.257 1.075.124l1.217-.456a1.125 1.125 0 011.37.49l1.296 2.247a1.125 1.125 0 01-.26 1.431l-1.003.827c-.293.24-.438.613-.431.992a6.759 6.759 0 010 .255c-.007.378.138.75.43.99l1.005.828c.424.35.534.954.26 1.43l-1.298 2.247a1.125 1.125 0 01-1.369.491l-1.217-.456c-.355-.133-.75-.072-1.076.124a6.57 6.57 0 01-.22.128c-.331.183-.581.495-.644.869l-.213 1.28c-.09.543-.56.941-1.11.941h-2.594c-.55 0-1.02-.398-1.11-.94l-.213-1.281c-.062-.374-.312-.686-.644-.87a6.52 6.52 0 01-.22-.127c-.325-.196-.72-.257-1.076-.124l-1.217.456a1.125 1.125 0 01-1.369-.49l-1.297-2.247a1.125 1.125 0 01.26-1.431l1.004-.827c.292-.24.437-.613.43-.992a6.932 6.932 0 010-.255c.007-.378-.138-.75-.43-.99l-1.004-.828a1.125 1.125 0 01-.26-1.43l1.297-2.247a1.125 1.125 0 011.37-.491l1.216.456c.356.133.751.072 1.076-.124.072-.044.146-.087.22-.128.332-.183.582-.495.644-.869l.214-1.281z" /><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
                )}
                <span>{item.label}</span>
              </a>
            ))}
          </nav>

          <!-- Ver tienda + Logout -->
          <div class="p-4 border-t border-white/10 space-y-1">
            <a href="/" target="_blank" class="nav-item text-[#25D366] hover:text-white hover:bg-[#25D366]/20">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" /></svg>
              <span>Ver tienda</span>
            </a>
            <button @click="logout()" class="nav-item w-full text-red-400 hover:text-red-300 hover:bg-red-500/10">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 9V5.25A2.25 2.25 0 0013.5 3h-6a2.25 2.25 0 00-2.25 2.25v13.5A2.25 2.25 0 007.5 21h6a2.25 2.25 0 002.25-2.25V15M12 9l-3 3m0 0l3 3m-3-3h12.75" /></svg>
              <span>Cerrar sesión</span>
            </button>
          </div>
        </aside>

        <!-- Main content area -->
        <main class="admin-main">
          <!-- Top bar (mobile) -->
          <div class="lg:hidden flex items-center justify-between px-4 py-3 bg-white border-b border-gray-100 sticky top-0 z-30">
            <button @click="sidebarOpen = true" class="w-9 h-9 rounded-lg bg-gray-100 flex items-center justify-center">
              <svg class="w-5 h-5 text-gray-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
              </svg>
            </button>
            <span class="font-bold text-gray-800 text-sm">WhatsUpShop Admin</span>
            <div class="w-9"></div>
          </div>

          <!-- Page content -->
          <div class="p-4 sm:p-6 lg:p-8">
            <slot />
          </div>
        </main>
      </div>
    </template>

    <!-- Toast notifications -->
    <div id="toast-container" class="fixed bottom-6 right-6 z-[100] space-y-2"></div>
  </div>

  <!-- Alpine.js -->
  <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>

  <!-- Admin Auth & Utilities -->
  <!-- API_URL is injected from PUBLIC_API_URL at build time via define:vars -->
  <script is:inline define:vars={{ API_URL: apiUrl }}>

    // Toast helper
    window.showToast = function(message, type = 'success') {
      const container = document.getElementById('toast-container');
      const toast = document.createElement('div');
      toast.className = `toast toast-${type}`;
      toast.textContent = message;
      container.appendChild(toast);
      setTimeout(() => { toast.style.opacity = '0'; toast.style.transition = 'opacity 0.3s'; }, 2500);
      setTimeout(() => toast.remove(), 3000);
    };

    // API helper with JWT
    window.apiFetch = async function(path, options = {}) {
      const token = localStorage.getItem('admin_token');
      const headers = { ...options.headers };
      if (token) headers['Authorization'] = `Bearer ${token}`;
      if (!(options.body instanceof FormData)) {
        headers['Content-Type'] = 'application/json';
      }

      const res = await fetch(`${API_URL}${path}`, { ...options, headers });

      if (res.status === 401) {
        localStorage.removeItem('admin_token');
        window.location.href = '/admin';
        throw new Error('Session expired');
      }

      return res;
    };

    // Auth Alpine component
    window.adminAuth = function() {
      return {
        authenticated: false,
        sidebarOpen: false,
        loginForm: { username: '', password: '' },
        loginError: '',
        loginLoading: false,

        checkAuth() {
          const token = localStorage.getItem('admin_token');
          if (token) {
            this.authenticated = true;
          }
        },

        async login() {
          this.loginError = '';
          this.loginLoading = true;
          try {
            const res = await fetch(`${API_URL}/admin/login`, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(this.loginForm),
            });
            const data = await res.json();
            if (!res.ok) {
              this.loginError = data.error || 'Error al iniciar sesión';
              return;
            }
            localStorage.setItem('admin_token', data.token);
            this.authenticated = true;
            // Redirect to dashboard if on login page
            if (window.location.pathname === '/admin' || window.location.pathname === '/admin/') {
              window.location.href = '/admin/dashboard';
            }
          } catch (e) {
            this.loginError = 'No se pudo conectar al servidor';
          } finally {
            this.loginLoading = false;
          }
        },

        logout() {
          localStorage.removeItem('admin_token');
          this.authenticated = false;
          window.location.href = '/admin';
        },
      };
    };
  </script>
</body>
</html>
