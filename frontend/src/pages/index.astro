---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import CategoryFilter from '../components/CategoryFilter.astro';
import Cart from '../components/Cart.astro';

import { API_BASE_URL } from '../lib/api';
const API_URL = API_BASE_URL;

let categories: any[] = [];
let config: Record<string, string> = {};

try {
  const [categoriesRes, configRes] = await Promise.all([
    fetch(`${API_URL}/categories`),
    fetch(`${API_URL}/config`),
  ]);
  categories = categoriesRes.ok ? await categoriesRes.json() : [];
  config = configRes.ok ? await configRes.json() : {};
} catch (e) {}

const storeName = config.store_name || 'WhatsUpShop';
const whatsappNumber = config.whatsapp_number || '1234567890';
const currency = config.currency || 'USD';
---

<BaseLayout title={`${storeName} — Catálogo`} description={`Compra fácil por WhatsApp en ${storeName}.`}>
  <div class="pb-24">
    <Header storeName={storeName} />
    <CategoryFilter categories={categories} />

    <section class="mt-2">
      <div id="products-grid" class="product-grid px-4"></div>

      <div id="sentinel" class="flex justify-center items-center py-10 gap-3">
        <div id="spinner" class="hidden w-7 h-7 border-2 border-[#25D366] border-t-transparent rounded-full animate-spin"></div>
        <p id="no-more" class="hidden text-gray-400 text-sm font-medium">No hay más productos</p>
        <p id="empty-state" class="hidden text-gray-400 text-sm font-medium">No hay productos en esta categoría</p>
      </div>
    </section>
  </div>

  <Cart whatsappNumber={whatsappNumber} currency={currency} apiBase={API_URL} />
</BaseLayout>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  @keyframes spin {
    to { transform: rotate(360deg); }
  }
  .animate-spin { animation: spin 0.8s linear infinite; }
</style>

<script define:vars={{ API_BASE: API_URL, CURRENCY: currency }}>
  const LIMIT = 12;
  let page = 0;
  let totalPages = 1;
  let loading = false;
  let currentCategory = 'all';

  const grid     = document.getElementById('products-grid');
  const spinner  = document.getElementById('spinner');
  const noMore   = document.getElementById('no-more');
  const empty    = document.getElementById('empty-state');
  const sentinel = document.getElementById('sentinel');

  function escape(str) {
    return String(str)
      .replace(/&/g, '&amp;')
      .replace(/"/g, '&quot;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;');
  }

  function cardHTML(p) {
    const hasDiscount = p.discountPrice && p.discountPrice > 0 && p.discountPrice < p.normalPrice;
    const price       = hasDiscount ? p.discountPrice : p.normalPrice;
    const pct         = hasDiscount ? Math.round(100 - (p.discountPrice / p.normalPrice) * 100) : 0;
    const img         = p.thumbnail || p.imageUrl || '/placeholder.jpg';
    const cartData    = escape(JSON.stringify({ id: p.id, slug: p.slug, title: p.title, price, imageUrl: img }));

    return `
<div data-product-cat="${p.categoryId || 'null'}"
     class="product-card bg-white rounded-2xl overflow-hidden shadow-sm hover:shadow-lg transition-all duration-300">
  <a href="/product/${escape(p.slug)}" class="block">
    <div class="relative aspect-square overflow-hidden bg-gray-50">
      <img src="${escape(img)}" alt="${escape(p.title)}" loading="lazy"
           class="w-full h-full object-cover hover:scale-105 transition-transform duration-500"
           onerror="this.style.display='none'" />
      ${hasDiscount ? `<span class="absolute top-2 left-2 bg-red-500 text-white text-[10px] font-bold px-2 py-0.5 rounded-full shadow-sm">-${pct}%</span>` : ''}
    </div>
  </a>
  <div class="p-3 pb-2">
    <a href="/product/${escape(p.slug)}" class="block">
      <p class="text-sm text-gray-800 font-medium leading-snug line-clamp-2 min-h-[2.5em]">${escape(p.title)}</p>
    </a>
    <div class="flex items-baseline gap-1.5 mt-1.5">
      <span class="text-[#25D366] font-bold text-sm">$${price.toFixed(2)}</span>
      ${hasDiscount ? `<span class="text-gray-400 text-xs line-through">$${p.normalPrice.toFixed(2)}</span>` : ''}
      <span class="text-gray-400 text-xs font-medium ml-auto">${CURRENCY}</span>
    </div>
  </div>
  <div class="px-3 pb-3">
    <button class="w-full py-2.5 bg-[#25D366] hover:bg-[#128C7E] text-white text-sm font-semibold rounded-xl flex items-center justify-center gap-2 transition-all btn-press shadow-sm"
            data-product="${cartData}"
            onclick="window.addToCart(JSON.parse(this.dataset.product))">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round"
          d="M2.25 3h1.386c.51 0 .955.343 1.087.835l.383 1.437M7.5 14.25a3 3 0 00-3 3h15.75m-12.75-3h11.218c1.121-2.3 2.1-4.684 2.924-7.138a60.114 60.114 0 00-16.536-1.84M7.5 14.25L5.106 5.272M6 20.25a.75.75 0 11-1.5 0 .75.75 0 011.5 0zm12.75 0a.75.75 0 11-1.5 0 .75.75 0 011.5 0z"/>
      </svg>
      Añadir
    </button>
  </div>
</div>`;
  }

  async function loadMore() {
    if (loading || page >= totalPages) return;
    loading = true;
    spinner.classList.remove('hidden');
    noMore.classList.add('hidden');
    empty.classList.add('hidden');

    const next = page + 1;
    const catParam = currentCategory !== 'all' ? `&category=${currentCategory}` : '';

    try {
      const res  = await fetch(`${API_BASE}/products?page=${next}&limit=${LIMIT}${catParam}`);
      const data = await res.json();
      const list = Array.isArray(data) ? data : (data.data || []);
      totalPages = data.pagination?.totalPages ?? totalPages;

      if (list.length === 0 && page === 0) {
        empty.classList.remove('hidden');
      } else {
        list.forEach(p => grid.insertAdjacentHTML('beforeend', cardHTML(p)));
        page = next;
        if (page >= totalPages) noMore.classList.remove('hidden');
      }
    } catch (e) {
      console.error('Error cargando productos:', e);
    }

    spinner.classList.add('hidden');
    loading = false;
  }

  // Infinite scroll observer
  const observer = new IntersectionObserver(
    entries => { if (entries[0].isIntersecting) loadMore(); },
    { rootMargin: '300px' }
  );
  observer.observe(sentinel);

  // Category filter (overrides the one in CategoryFilter.astro)
  window.filterCategory = function(catId, btn) {
    document.querySelectorAll('.category-btn').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    currentCategory = catId;
    page = 0;
    totalPages = 1;
    grid.innerHTML = '';
    noMore.classList.add('hidden');
    empty.classList.add('hidden');
    loadMore();
  };

  // Search filter
  document.addEventListener('search', e => {
    const q = e.detail.q.toLowerCase().trim();
    grid.querySelectorAll('[data-product-cat]').forEach(card => {
      const title = card.querySelector('p')?.textContent?.toLowerCase() || '';
      card.style.display = (!q || title.includes(q)) ? '' : 'none';
    });
  });
</script>
