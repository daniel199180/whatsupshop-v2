---
import AdminLayout from '../../layouts/AdminLayout.astro';
---
<AdminLayout title="Pedidos — WhatsUpShop Admin" currentPage="orders">
  <div x-data="ordersPage()" x-init="load()">
    <!-- Page header -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 mb-6">
      <div>
        <h1 class="text-2xl font-bold text-gray-900">Pedidos</h1>
        <p class="text-gray-500 text-sm mt-1">Historial de pedidos recibidos por WhatsApp</p>
      </div>
      <span class="badge badge-green text-sm" x-show="orders.length > 0" x-text="orders.length + ' pedido(s)'"></span>
    </div>

    <!-- Orders list -->
    <div class="space-y-3">
      <template x-if="loading">
        <div class="text-center py-12 text-gray-400">Cargando...</div>
      </template>
      <template x-if="!loading && orders.length === 0">
        <div class="empty-state bg-white rounded-2xl border border-gray-100">
          <div class="w-14 h-14 bg-gray-100 rounded-full flex items-center justify-center mb-3">
            <svg class="w-7 h-7 text-gray-300" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 10.5V6a3.75 3.75 0 10-7.5 0v4.5m11.356-1.993l1.263 12c.07.665-.45 1.243-1.119 1.243H4.25a1.125 1.125 0 01-1.12-1.243l1.264-12A1.125 1.125 0 015.513 7.5h12.974c.576 0 1.059.435 1.119 1.007zM8.625 10.5a.375.375 0 11-.75 0 .375.375 0 01.75 0zm7.5 0a.375.375 0 11-.75 0 .375.375 0 01.75 0z" /></svg>
          </div>
          <p class="text-gray-500 font-semibold text-sm">No hay pedidos aún</p>
          <p class="text-gray-400 text-xs mt-1">Los pedidos aparecerán aquí cuando los clientes compren</p>
        </div>
      </template>
      <template x-for="order in orders" :key="order.id">
        <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-5 hover:shadow-md transition-all">
          <div class="flex items-start justify-between gap-4">
            <div class="flex-1 min-w-0">
              <div class="flex items-center gap-2 mb-2">
                <span class="badge badge-green">Pedido #<span x-text="order.id"></span></span>
                <span class="text-xs text-gray-400" x-text="new Date(order.createdAt).toLocaleString('es', { dateStyle: 'medium', timeStyle: 'short' })"></span>
              </div>
              <pre class="text-sm text-gray-700 whitespace-pre-wrap font-sans leading-relaxed bg-gray-50 rounded-xl p-4" x-text="order.message"></pre>
            </div>
            <button @click="deleteOrder(order.id)" class="shrink-0 w-8 h-8 rounded-lg bg-red-50 flex items-center justify-center hover:bg-red-100 transition-colors" title="Eliminar pedido">
              <svg class="w-4 h-4 text-red-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 01-2.244 2.077H8.084a2.25 2.25 0 01-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 00-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 013.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 00-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 00-7.5 0" /></svg>
            </button>
          </div>
        </div>
      </template>
    </div>
  </div>

  <script is:inline>
    window.ordersPage = function() {
      return {
        orders: [],
        loading: true,

        async load() {
          this.loading = true;
          try {
            const res = await apiFetch('/admin/orders');
            this.orders = res.ok ? await res.json() : [];
            // Sort newest first
            this.orders.sort((a, b) => new Date(b.createdAt) - new Date(a.createdAt));
          } catch (e) { console.error(e); }
          this.loading = false;
        },

        async deleteOrder(id) {
          if (!confirm('¿Eliminar este pedido?')) return;
          try {
            const res = await apiFetch(`/admin/orders/${id}`, { method: 'DELETE' });
            if (res.ok) {
              showToast('Pedido eliminado');
              this.orders = this.orders.filter(o => o.id !== id);
            } else {
              showToast('Error al eliminar', 'error');
            }
          } catch (e) {
            showToast('Error al eliminar', 'error');
          }
        },
      };
    };
  </script>
</AdminLayout>
