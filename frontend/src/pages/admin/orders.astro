---
import AdminLayout from '../../layouts/AdminLayout.astro';
---
<AdminLayout title="Pedidos — WhatsUpShop Admin" currentPage="orders">
  <div x-data="ordersPage()" x-init="load()">

    <!-- Page header -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 mb-6">
      <div>
        <h1 class="text-2xl font-bold text-gray-900">Pedidos</h1>
        <p class="text-gray-500 text-sm mt-1">Historial de pedidos recibidos</p>
      </div>
      <div class="flex items-center gap-2">
        <span class="badge badge-green text-sm" x-show="filteredOrders().length > 0" x-text="filteredOrders().length + ' pedido(s)'"></span>
        <span class="text-xs text-gray-400" x-show="isFiltered()" x-text="'de ' + orders.length + ' total'"></span>
      </div>
    </div>

    <!-- Filters -->
    <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-4 mb-5">
      <p class="text-xs font-semibold text-gray-400 uppercase tracking-widest mb-3">Filtrar pedidos</p>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
        <!-- Name filter -->
        <div class="relative">
          <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-gray-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z" />
          </svg>
          <input
            type="text"
            x-model="filterName"
            placeholder="Buscar por nombre..."
            class="w-full pl-9 pr-3 py-2 text-sm border border-gray-200 rounded-xl focus:border-[#25D366] outline-none transition-colors"
          />
        </div>
        <!-- Phone filter -->
        <div class="relative">
          <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-gray-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
          </svg>
          <input
            type="tel"
            x-model="filterPhone"
            placeholder="Buscar por teléfono..."
            class="w-full pl-9 pr-3 py-2 text-sm border border-gray-200 rounded-xl focus:border-[#25D366] outline-none transition-colors"
          />
        </div>
        <!-- Date filter -->
        <div class="relative">
          <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-gray-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5" />
          </svg>
          <input
            type="date"
            x-model="filterDate"
            class="w-full pl-9 pr-3 py-2 text-sm border border-gray-200 rounded-xl focus:border-[#25D366] outline-none transition-colors text-gray-700"
          />
        </div>
      </div>
      <!-- Clear filters -->
      <div class="mt-3 flex justify-end" x-show="isFiltered()">
        <button
          @click="clearFilters()"
          class="text-xs text-gray-500 hover:text-gray-700 font-semibold flex items-center gap-1 transition-colors"
        >
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
          Limpiar filtros
        </button>
      </div>
    </div>

    <!-- Orders list -->
    <div class="space-y-3">
      <template x-if="loading">
        <div class="text-center py-12 text-gray-400">Cargando...</div>
      </template>

      <template x-if="!loading && orders.length === 0">
        <div class="empty-state bg-white rounded-2xl border border-gray-100">
          <div class="w-14 h-14 bg-gray-100 rounded-full flex items-center justify-center mb-3">
            <svg class="w-7 h-7 text-gray-300" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 10.5V6a3.75 3.75 0 10-7.5 0v4.5m11.356-1.993l1.263 12c.07.665-.45 1.243-1.119 1.243H4.25a1.125 1.125 0 01-1.12-1.243l1.264-12A1.125 1.125 0 015.513 7.5h12.974c.576 0 1.059.435 1.119 1.007zM8.625 10.5a.375.375 0 11-.75 0 .375.375 0 01.75 0zm7.5 0a.375.375 0 11-.75 0 .375.375 0 01.75 0z" /></svg>
          </div>
          <p class="text-gray-500 font-semibold text-sm">No hay pedidos aún</p>
          <p class="text-gray-400 text-xs mt-1">Los pedidos aparecerán aquí cuando los clientes compren</p>
        </div>
      </template>

      <template x-if="!loading && orders.length > 0 && filteredOrders().length === 0">
        <div class="text-center py-10 bg-white rounded-2xl border border-gray-100">
          <svg class="w-8 h-8 text-gray-300 mx-auto mb-2" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 15.803 7.5 7.5 0 0015.803 15.803z" />
          </svg>
          <p class="text-gray-500 text-sm font-semibold">Sin resultados</p>
          <p class="text-gray-400 text-xs mt-1">Prueba con otros filtros</p>
        </div>
      </template>

      <template x-for="order in filteredOrders()" :key="order.id">
        <div class="bg-white rounded-2xl border border-gray-100 shadow-sm hover:shadow-md transition-all overflow-hidden">

          <!-- Order header -->
          <div class="flex items-center justify-between px-5 pt-4 pb-3 border-b border-gray-50">
            <div class="flex items-center gap-2 flex-wrap">
              <span class="badge badge-green">Pedido #<span x-text="order.id"></span></span>
              <span class="text-xs text-gray-400" x-text="new Date(order.createdAt).toLocaleString('es', { dateStyle: 'medium', timeStyle: 'short' })"></span>
            </div>
            <button @click="deleteOrder(order.id)" class="shrink-0 w-8 h-8 rounded-lg bg-red-50 flex items-center justify-center hover:bg-red-100 transition-colors" title="Eliminar pedido">
              <svg class="w-4 h-4 text-red-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 01-2.244 2.077H8.084a2.25 2.25 0 01-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 00-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 013.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 00-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 00-7.5 0" /></svg>
            </button>
          </div>

          <div class="px-5 py-4 space-y-4">
            <!-- Customer info -->
            <div class="flex flex-wrap gap-4">
              <div class="flex items-center gap-2 min-w-0">
                <div class="w-8 h-8 rounded-full bg-gray-100 flex items-center justify-center shrink-0">
                  <svg class="w-4 h-4 text-gray-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z" />
                  </svg>
                </div>
                <div>
                  <p class="text-[10px] text-gray-400 font-semibold uppercase tracking-wider">Cliente</p>
                  <p class="text-sm font-bold text-gray-800" x-text="order.customerName || '—'"></p>
                </div>
              </div>
              <div class="flex items-center gap-2 min-w-0">
                <div class="w-8 h-8 rounded-full bg-[#25D366]/10 flex items-center justify-center shrink-0">
                  <svg class="w-4 h-4 text-[#25D366]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
                  </svg>
                </div>
                <div>
                  <p class="text-[10px] text-gray-400 font-semibold uppercase tracking-wider">Teléfono</p>
                  <a :href="'tel:' + order.customerPhone" class="text-sm font-bold text-[#25D366] hover:underline" x-text="order.customerPhone || '—'"></a>
                </div>
              </div>
            </div>

            <!-- Products ordered -->
            <div>
              <p class="text-[10px] text-gray-400 font-semibold uppercase tracking-wider mb-2">Productos</p>
              <div class="bg-gray-50 rounded-xl p-3 space-y-1">
                <template x-for="line in parseItems(order.message)" :key="line">
                  <div class="flex items-start gap-2">
                    <span class="text-[#25D366] font-bold text-sm leading-5 shrink-0">•</span>
                    <span class="text-sm text-gray-700 leading-5" x-text="line"></span>
                  </div>
                </template>
              </div>
            </div>

            <!-- Total -->
            <div class="flex items-center justify-between pt-1 border-t border-gray-100">
              <span class="text-xs text-gray-400 font-semibold uppercase tracking-wider">Total del pedido</span>
              <span class="text-base font-extrabold text-gray-900" x-text="parseTotal(order.message)"></span>
            </div>
          </div>
        </div>
      </template>
    </div>
  </div>

  <script is:inline>
    window.ordersPage = function() {
      return {
        orders: [],
        loading: true,
        filterName:  '',
        filterPhone: '',
        filterDate:  '',

        async load() {
          this.loading = true;
          try {
            const res = await apiFetch('/admin/orders');
            this.orders = res.ok ? await res.json() : [];
            this.orders.sort((a, b) => new Date(b.createdAt) - new Date(a.createdAt));
          } catch (e) { console.error(e); }
          this.loading = false;
        },

        filteredOrders() {
          return this.orders.filter(order => {
            const name  = (order.customerName  || '').toLowerCase();
            const phone = (order.customerPhone || '');
            const date  = order.createdAt
              ? new Date(order.createdAt).toLocaleDateString('sv-SE') // "YYYY-MM-DD"
              : '';

            const matchName  = !this.filterName.trim()  || name.includes(this.filterName.trim().toLowerCase());
            const matchPhone = !this.filterPhone.trim() || phone.includes(this.filterPhone.trim());
            const matchDate  = !this.filterDate          || date === this.filterDate;

            return matchName && matchPhone && matchDate;
          });
        },

        isFiltered() {
          return this.filterName.trim() || this.filterPhone.trim() || this.filterDate;
        },

        clearFilters() {
          this.filterName  = '';
          this.filterPhone = '';
          this.filterDate  = '';
        },

        // Extrae las líneas de productos del mensaje (líneas que empiezan con •)
        parseItems(message) {
          if (!message) return [];
          return message
            .split('\n')
            .filter(l => l.trim().startsWith('•'))
            .map(l => l.replace(/^•\s*/, '').trim());
        },

        // Extrae el total del mensaje
        parseTotal(message) {
          if (!message) return '—';
          const match = message.match(/TOTAL:\s*([^\n*]+)/);
          return match ? match[1].trim() : '—';
        },

        async deleteOrder(id) {
          if (!confirm('¿Eliminar este pedido?')) return;
          try {
            const res = await apiFetch(`/admin/orders/${id}`, { method: 'DELETE' });
            if (res.ok) {
              showToast('Pedido eliminado');
              this.orders = this.orders.filter(o => o.id !== id);
            } else {
              showToast('Error al eliminar', 'error');
            }
          } catch (e) {
            showToast('Error al eliminar', 'error');
          }
        },
      };
    };
  </script>
</AdminLayout>
