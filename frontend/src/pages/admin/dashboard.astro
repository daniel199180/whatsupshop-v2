---
import AdminLayout from '../../layouts/AdminLayout.astro';
---
<AdminLayout title="Dashboard — WhatsUpShop Admin" currentPage="dashboard">
  <div x-data="dashboardPage()" x-init="loadStats()">
    <!-- Page header -->
    <div class="mb-6">
      <h1 class="text-2xl font-bold text-gray-900">Dashboard</h1>
      <p class="text-gray-500 text-sm mt-1">Resumen general de tu tienda</p>
    </div>

    <!-- Stats grid -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
      <!-- Total Products -->
      <div class="stat-card">
        <div class="flex items-center justify-between mb-3">
          <div class="w-10 h-10 rounded-xl bg-blue-50 flex items-center justify-center">
            <svg class="w-5 h-5 text-blue-500" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M20.25 7.5l-.625 10.632a2.25 2.25 0 01-2.247 2.118H6.622a2.25 2.25 0 01-2.247-2.118L3.75 7.5M10 11.25h4M3.375 7.5h17.25c.621 0 1.125-.504 1.125-1.125v-1.5c0-.621-.504-1.125-1.125-1.125H3.375c-.621 0-1.125.504-1.125 1.125v1.5c0 .621.504 1.125 1.125 1.125z" /></svg>
          </div>
        </div>
        <p class="text-2xl font-extrabold text-gray-900" x-text="stats.totalProducts">—</p>
        <p class="text-xs text-gray-500 mt-1">Productos totales</p>
      </div>

      <!-- Active Products -->
      <div class="stat-card">
        <div class="flex items-center justify-between mb-3">
          <div class="w-10 h-10 rounded-xl bg-green-50 flex items-center justify-center">
            <svg class="w-5 h-5 text-green-500" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
          </div>
        </div>
        <p class="text-2xl font-extrabold text-gray-900" x-text="stats.activeProducts">—</p>
        <p class="text-xs text-gray-500 mt-1">Productos activos</p>
      </div>

      <!-- Categories -->
      <div class="stat-card">
        <div class="flex items-center justify-between mb-3">
          <div class="w-10 h-10 rounded-xl bg-purple-50 flex items-center justify-center">
            <svg class="w-5 h-5 text-purple-500" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9.568 3H5.25A2.25 2.25 0 003 5.25v4.318c0 .597.237 1.17.659 1.591l9.581 9.581c.699.699 1.78.872 2.607.33a18.095 18.095 0 005.223-5.223c.542-.827.369-1.908-.33-2.607L11.16 3.66A2.25 2.25 0 009.568 3z" /></svg>
          </div>
        </div>
        <p class="text-2xl font-extrabold text-gray-900" x-text="stats.totalCategories">—</p>
        <p class="text-xs text-gray-500 mt-1">Categorías</p>
      </div>

      <!-- Orders -->
      <div class="stat-card">
        <div class="flex items-center justify-between mb-3">
          <div class="w-10 h-10 rounded-xl bg-amber-50 flex items-center justify-center">
            <svg class="w-5 h-5 text-amber-500" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 10.5V6a3.75 3.75 0 10-7.5 0v4.5m11.356-1.993l1.263 12c.07.665-.45 1.243-1.119 1.243H4.25a1.125 1.125 0 01-1.12-1.243l1.264-12A1.125 1.125 0 015.513 7.5h12.974c.576 0 1.059.435 1.119 1.007zM8.625 10.5a.375.375 0 11-.75 0 .375.375 0 01.75 0zm7.5 0a.375.375 0 11-.75 0 .375.375 0 01.75 0z" /></svg>
          </div>
        </div>
        <p class="text-2xl font-extrabold text-gray-900" x-text="stats.totalOrders">—</p>
        <p class="text-xs text-gray-500 mt-1">Pedidos recibidos</p>
      </div>
    </div>

    <!-- Quick actions -->
    <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-6">
      <h2 class="font-bold text-gray-800 mb-4">Acciones rápidas</h2>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
        <a href="/admin/products" class="flex items-center gap-3 p-4 rounded-xl border border-gray-100 hover:border-[#25D366] hover:bg-[#25D366]/5 transition-all group">
          <div class="w-10 h-10 rounded-lg bg-green-50 flex items-center justify-center group-hover:bg-[#25D366]/10">
            <svg class="w-5 h-5 text-green-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg>
          </div>
          <div>
            <p class="font-semibold text-sm text-gray-800">Nuevo producto</p>
            <p class="text-xs text-gray-500">Agregar al catálogo</p>
          </div>
        </a>
        <a href="/admin/categories" class="flex items-center gap-3 p-4 rounded-xl border border-gray-100 hover:border-[#25D366] hover:bg-[#25D366]/5 transition-all group">
          <div class="w-10 h-10 rounded-lg bg-purple-50 flex items-center justify-center group-hover:bg-[#25D366]/10">
            <svg class="w-5 h-5 text-purple-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg>
          </div>
          <div>
            <p class="font-semibold text-sm text-gray-800">Nueva categoría</p>
            <p class="text-xs text-gray-500">Organizar productos</p>
          </div>
        </a>
        <a href="/admin/orders" class="flex items-center gap-3 p-4 rounded-xl border border-gray-100 hover:border-[#25D366] hover:bg-[#25D366]/5 transition-all group">
          <div class="w-10 h-10 rounded-lg bg-amber-50 flex items-center justify-center group-hover:bg-[#25D366]/10">
            <svg class="w-5 h-5 text-amber-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178z" /><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
          </div>
          <div>
            <p class="font-semibold text-sm text-gray-800">Ver pedidos</p>
            <p class="text-xs text-gray-500">Pedidos de WhatsApp</p>
          </div>
        </a>
      </div>
    </div>
  </div>

  <script is:inline>
    window.dashboardPage = function() {
      return {
        stats: { totalProducts: '—', activeProducts: '—', totalCategories: '—', totalOrders: '—' },

        async loadStats() {
          try {
            const res = await apiFetch('/admin/stats');
            if (res.ok) {
              this.stats = await res.json();
            }
          } catch (e) {
            console.error('Failed to load stats:', e);
          }
        }
      };
    };
  </script>
</AdminLayout>
