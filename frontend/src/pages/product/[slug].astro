---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Cart from '../../components/Cart.astro';

const { slug } = Astro.params;
const API_URL = import.meta.env.PUBLIC_API_URL || 'http://localhost:3000';

let product: any = null;
let config: Record<string, string> = {};
let relatedProducts: any[] = [];

try {
  const [productRes, configRes] = await Promise.all([
    fetch(`${API_URL}/products/${slug}`),
    fetch(`${API_URL}/config`),
  ]);
  product = productRes.ok ? await productRes.json() : null;
  config = configRes.ok ? await configRes.json() : {};

  // Fetch related products from same category
  if (product?.categoryId) {
    const relatedRes = await fetch(`${API_URL}/products?category=${product.categoryId}&limit=4`);
    if (relatedRes.ok) {
      const data = await relatedRes.json();
      const allRelated = Array.isArray(data) ? data : (data.data || []);
      relatedProducts = allRelated.filter((p: any) => p.id !== product.id).slice(0, 4);
    }
  }
} catch (e) {}

const storeName = config.store_name || 'EcoStore WhatsApp';
const whatsappNumber = config.whatsapp_number || '1234567890';
const currency = config.currency || 'USD';
const hasDiscount = product?.discountPrice && product.discountPrice > 0 && product.discountPrice < product.normalPrice;
const displayPrice = hasDiscount ? product.discountPrice : product?.normalPrice;
const discountPct = hasDiscount ? Math.round(100 - (product.discountPrice / product.normalPrice) * 100) : 0;
const images = product?.moreImages ? [product.imageUrl, ...product.moreImages].filter(Boolean) : [product?.imageUrl].filter(Boolean);
---
<BaseLayout title={product ? `${product.title} — ${storeName}` : 'Producto no encontrado'}>
  {!product ? (
    <!-- 404 State -->
    <div class="flex flex-col items-center justify-center min-h-screen text-center px-8">
      <div class="w-20 h-20 bg-gray-100 rounded-full flex items-center justify-center mb-5">
        <svg class="w-10 h-10 text-gray-300" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 10.5V6a3.75 3.75 0 10-7.5 0v4.5m11.356-1.993l1.263 12c.07.665-.45 1.243-1.119 1.243H4.25a1.125 1.125 0 01-1.12-1.243l1.264-12A1.125 1.125 0 015.513 7.5h12.974c.576 0 1.059.435 1.119 1.007zM8.625 10.5a.375.375 0 11-.75 0 .375.375 0 01.75 0zm7.5 0a.375.375 0 11-.75 0 .375.375 0 01.75 0z" />
        </svg>
      </div>
      <p class="text-gray-600 font-semibold text-lg">Producto no encontrado</p>
      <p class="text-gray-400 text-sm mt-2">El producto que buscas no existe o fue removido.</p>
      <a href="/" class="mt-6 inline-flex items-center gap-2 px-5 py-2.5 bg-[#25D366] text-white font-semibold rounded-xl hover:bg-[#128C7E] transition-colors btn-press shadow-md shadow-[#25D366]/25">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
        </svg>
        Volver al catálogo
      </a>
    </div>
  ) : (
    <div class="pb-28">
      <!-- Sticky back bar -->
      <div class="sticky top-0 z-50 bg-white/95 backdrop-blur-md px-4 py-3 flex items-center justify-between border-b border-gray-100">
        <a href="/" class="flex items-center gap-2 text-gray-700 hover:text-[#25D366] transition-colors font-medium text-sm" id="back-btn">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" />
          </svg>
          Volver
        </a>
        <span class="text-xs text-gray-400 font-medium">{product.category?.name || ''}</span>
      </div>

      <!-- Product Detail Layout (stacks on mobile, side-by-side on desktop) -->
      <div class="product-detail-layout">
        <!-- Image Section -->
        <div class="product-detail-image">
          <div class="relative">
            <div class="aspect-square bg-gray-50 overflow-hidden" id="main-image-container">
              <img
                src={product.imageUrl || '/placeholder.jpg'}
                alt={product.title}
                class="w-full h-full object-cover transition-opacity duration-300"
                id="main-img-el"
              />
            </div>
            {hasDiscount && (
              <span class="absolute top-3 left-3 bg-red-500 text-white text-xs font-bold px-3 py-1.5 rounded-full shadow-md flex items-center gap-1">
                <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M5 2a1 1 0 011 1v1h1a1 1 0 010 2H6v1a1 1 0 01-2 0V6H3a1 1 0 010-2h1V3a1 1 0 011-1zm0 10a1 1 0 011 1v1h1a1 1 0 110 2H6v1a1 1 0 11-2 0v-1H3a1 1 0 110-2h1v-1a1 1 0 011-1zM12 2a1 1 0 01.967.744L14.146 7.2 17.5 9.134a1 1 0 010 1.732l-3.354 1.935-1.18 4.455a1 1 0 01-1.933 0L9.854 12.8 6.5 10.866a1 1 0 010-1.732l3.354-1.935 1.18-4.455A1 1 0 0112 2z" clip-rule="evenodd" />
                </svg>
                -{discountPct}%
              </span>
            )}
          </div>

          <!-- Thumbnail gallery -->
          {images.length > 1 && (
            <div class="flex gap-2 px-4 mt-3 overflow-x-auto hide-scrollbar">
              {images.map((img: string, i: number) => (
                <button
                  class="shrink-0 w-16 h-16 rounded-xl overflow-hidden border-2 border-gray-200 hover:border-[#25D366] focus:border-[#25D366] transition-all duration-200 thumbnail-btn"
                  onclick={`document.getElementById('main-img-el').src='${img}'; document.querySelectorAll('.thumbnail-btn').forEach(b=>b.classList.remove('border-[#25D366]')); this.classList.add('border-[#25D366]');`}
                >
                  <img src={img} alt={`${product.title} — imagen ${i + 1}`} class="w-full h-full object-cover" />
                </button>
              ))}
            </div>
          )}
        </div>

        <!-- Info Section -->
        <div class="product-detail-info px-4 mt-5 md:mt-0">
          <!-- Category badge -->
          {product.category?.name && (
            <span class="inline-block text-[#25D366] text-xs font-semibold uppercase tracking-wider bg-[#25D366]/10 px-2.5 py-1 rounded-full">
              {product.category.name}
            </span>
          )}

          <!-- Title -->
          <h1 class="text-xl sm:text-2xl font-bold text-gray-900 mt-2 leading-tight">{product.title}</h1>

          <!-- Price -->
          <div class="flex items-baseline gap-3 mt-3">
            <span class="text-[#25D366] font-extrabold text-2xl sm:text-3xl">${displayPrice?.toFixed(2)}</span>
            <span class="text-gray-400 text-sm font-medium">{currency}</span>
            {hasDiscount && (
              <span class="text-gray-400 text-base line-through">${product.normalPrice.toFixed(2)}</span>
            )}
          </div>

          {hasDiscount && (
            <div class="flex items-center gap-2 mt-2">
              <span class="text-xs font-semibold text-green-700 bg-green-100 px-2 py-0.5 rounded-full">
                Ahorras ${(product.normalPrice - product.discountPrice).toFixed(2)}
              </span>
            </div>
          )}

          <!-- Options/Variants -->
          {product.options && Array.isArray(product.options) && product.options.length > 0 && (
            <div class="mt-5">
              <p class="text-sm font-semibold text-gray-700 mb-2">Opciones disponibles</p>
              <div class="flex flex-wrap gap-2">
                {(product.options as any[]).map((opt: any) => (
                  <button class="px-4 py-2 border border-gray-200 rounded-xl text-sm text-gray-700 hover:border-[#25D366] hover:text-[#25D366] transition-all duration-200 btn-press">
                    {opt.name} {opt.price ? `+$${opt.price}` : ''}
                  </button>
                ))}
              </div>
            </div>
          )}

          <!-- Description -->
          <div class="mt-5 bg-gray-50 rounded-2xl p-4">
            <p class="text-sm font-semibold text-gray-700 mb-2">Descripción</p>
            <p class="text-sm text-gray-600 leading-relaxed">{product.description}</p>
          </div>

          <!-- Add to Cart CTA -->
          <button
            class="mt-6 w-full py-3.5 bg-[#25D366] hover:bg-[#128C7E] text-white font-bold rounded-2xl flex items-center justify-center gap-2.5 transition-all btn-press shadow-lg shadow-[#25D366]/30 text-base"
            onclick={`window.addToCart(${JSON.stringify({id: product.id, slug: product.slug, title: product.title, price: displayPrice, imageUrl: product.thumbnail || product.imageUrl})})`}
            id="add-to-cart-detail"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 3h1.386c.51 0 .955.343 1.087.835l.383 1.437M7.5 14.25a3 3 0 00-3 3h15.75m-12.75-3h11.218c1.121-2.3 2.1-4.684 2.924-7.138a60.114 60.114 0 00-16.536-1.84M7.5 14.25L5.106 5.272M6 20.25a.75.75 0 11-1.5 0 .75.75 0 011.5 0zm12.75 0a.75.75 0 11-1.5 0 .75.75 0 011.5 0z" />
            </svg>
            Añadir al carrito
          </button>

          <!-- Share buttons -->
          <div class="mt-4 flex items-center gap-3">
            <span class="text-xs text-gray-400 font-medium">Compartir:</span>
            <button
              onclick={`navigator.share ? navigator.share({title:'${product.title}', url: window.location.href}) : navigator.clipboard.writeText(window.location.href)`}
              class="w-8 h-8 rounded-full bg-gray-100 flex items-center justify-center hover:bg-gray-200 transition-colors"
              aria-label="Compartir producto"
            >
              <svg class="w-4 h-4 text-gray-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M7.217 10.907a2.25 2.25 0 100 2.186m0-2.186c.18.324.283.696.283 1.093s-.103.77-.283 1.093m0-2.186l9.566-5.314m-9.566 7.5l9.566 5.314m0 0a2.25 2.25 0 103.935 2.186 2.25 2.25 0 00-3.935-2.186zm0-12.814a2.25 2.25 0 103.933-2.185 2.25 2.25 0 00-3.933 2.185z" />
              </svg>
            </button>
            <a
              href={`https://wa.me/?text=${encodeURIComponent(`Mira este producto: ${product.title} — `)}`}
              target="_blank"
              class="w-8 h-8 rounded-full bg-[#25D366]/10 flex items-center justify-center hover:bg-[#25D366]/20 transition-colors"
              aria-label="Compartir por WhatsApp"
            >
              <svg class="w-4 h-4 text-[#25D366]" fill="currentColor" viewBox="0 0 24 24">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/>
              </svg>
            </a>
          </div>
        </div>
      </div>

      <!-- Related Products -->
      {relatedProducts.length > 0 && (
        <section class="mt-8 pb-4">
          <h2 class="font-bold text-gray-900 text-base sm:text-lg px-4 mb-3">Productos relacionados</h2>
          <div class="product-grid px-4">
            {relatedProducts.map((p: any) => (
              <div data-product-cat={p.categoryId?.toString() || 'null'} class="animate-fade-in-up">
                <a href={`/product/${p.slug}`} class="block bg-white rounded-2xl overflow-hidden shadow-sm hover:shadow-md transition-all duration-300">
                  <div class="aspect-square overflow-hidden bg-gray-50">
                    <img
                      src={p.thumbnail || p.imageUrl || '/placeholder.jpg'}
                      alt={p.title}
                      loading="lazy"
                      class="w-full h-full object-cover hover:scale-105 transition-transform duration-500"
                    />
                  </div>
                  <div class="p-3">
                    <p class="text-sm text-gray-800 font-medium leading-snug truncate">{p.title}</p>
                    <p class="text-gray-900 font-bold text-sm mt-1">${(p.discountPrice && p.discountPrice < p.normalPrice ? p.discountPrice : p.normalPrice).toFixed(2)} {currency}</p>
                  </div>
                </a>
              </div>
            ))}
          </div>
        </section>
      )}
    </div>
  )}

  <Cart whatsappNumber={whatsappNumber} currency={currency} />
</BaseLayout>
