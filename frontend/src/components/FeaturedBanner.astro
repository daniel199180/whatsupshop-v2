---
export interface Props {
  product: {
    id: number;
    slug: string;
    title: string;
    normalPrice: number;
    discountPrice?: number;
    imageUrl?: string;
    thumbnail?: string;
  };
}
const { product } = Astro.props;
const hasDiscount = product.discountPrice && product.discountPrice > 0 && product.discountPrice < product.normalPrice;
const displayPrice = hasDiscount ? product.discountPrice : product.normalPrice;
const discountPct = hasDiscount ? Math.round(100 - (product.discountPrice! / product.normalPrice) * 100) : 0;
const imgSrc = product.imageUrl || product.thumbnail || '/placeholder.jpg';
---
<a href={`/product/${product.slug}`} class="block mx-4 rounded-2xl overflow-hidden relative featured-banner bg-gray-900 shadow-lg group animate-fade-in-up" id="featured-banner">
  <!-- Product image -->
  {imgSrc ? (
    <img
      src={imgSrc}
      alt={product.title}
      class="w-full h-full object-cover opacity-90 group-hover:opacity-100 group-hover:scale-105 transition-all duration-500"
      loading="eager"
    />
  ) : (
    <div class="w-full h-full bg-gradient-to-br from-[#25D366] to-[#128C7E]" />
  )}

  <!-- Dark overlay gradient -->
  <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/20 to-transparent" />

  <!-- Discount badge -->
  {hasDiscount && (
    <span class="absolute top-3 left-3 bg-red-500 text-white text-xs font-bold px-3 py-1 rounded-full shadow-md flex items-center gap-1">
      <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20">
        <path fill-rule="evenodd" d="M5 2a1 1 0 011 1v1h1a1 1 0 010 2H6v1a1 1 0 01-2 0V6H3a1 1 0 010-2h1V3a1 1 0 011-1zm0 10a1 1 0 011 1v1h1a1 1 0 110 2H6v1a1 1 0 11-2 0v-1H3a1 1 0 110-2h1v-1a1 1 0 011-1zM12 2a1 1 0 01.967.744L14.146 7.2 17.5 9.134a1 1 0 010 1.732l-3.354 1.935-1.18 4.455a1 1 0 01-1.933 0L9.854 12.8 6.5 10.866a1 1 0 010-1.732l3.354-1.935 1.18-4.455A1 1 0 0112 2z" clip-rule="evenodd" />
      </svg>
      {discountPct}% OFF
    </span>
  )}

  <!-- Product info bottom -->
  <div class="absolute bottom-4 left-4 right-4">
    <p class="text-white font-bold text-lg sm:text-xl leading-tight drop-shadow-md">{product.title}</p>
    <div class="flex items-baseline gap-2 mt-1">
      <p class="text-white/90 font-semibold text-sm sm:text-base">${displayPrice?.toFixed(2)} USD</p>
      {hasDiscount && (
        <p class="text-white/50 text-xs line-through">${product.normalPrice.toFixed(2)}</p>
      )}
    </div>
  </div>
</a>
